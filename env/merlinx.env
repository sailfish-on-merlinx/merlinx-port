# HADK Environment Configuration for Xiaomi Redmi Note 9 (merlinx)
export ANDROID_ROOT=$HOME/hadk
export VENDOR=xiaomi
export DEVICE=merlinx
export HABUILD_DEVICE=merlinx
export PORT_ARCH=aarch64
export PLATFORM_SDK_ROOT=/srv/sailfishos

# Build acceleration
export USE_CCACHE=1
export CCACHE_EXEC=/usr/bin/ccache

# Tooling overrides
export XMLLINT=/usr/bin/xmllint
