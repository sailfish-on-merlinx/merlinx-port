<?xml version="1.0" encoding="UTF-8"?>
<manifest>
	<!-- Xiaomi Redmi Note 9 (merlinx) Device & Kernel Trees -->
	<project path="device/xiaomi/merlinx"
		name="LineageOS/android_device_xiaomi_merlinx"
		revision="lineage-23.2" />
	<project path="device/xiaomi/mt6768-common"
		name="LineageOS/android_device_xiaomi_mt6768-common"
		revision="lineage-23.2" />
	<project path="kernel/xiaomi/mt6768"
		name="LineageOS/android_kernel_xiaomi_mt6768"
		revision="lineage-23.2" />

	<!-- Proprietary Vendor Blobs (TheMuppets) -->
	<project path="vendor/xiaomi/merlinx"
		name="TheMuppets/proprietary_vendor_xiaomi_merlinx"
		revision="lineage-23.2" />
	<project path="vendor/xiaomi/mt6768-common"
		name="TheMuppets/proprietary_vendor_xiaomi_mt6768-common"
		revision="lineage-23.2" />

	<!-- Sailfish OS Hardware Adaptation Packages -->
	<project path="rpm/"
		name="sailfish-on-merlinx/droid-hal-merlinx"
		revision="main" />
	<project path="hybris/droid-configs"
		name="sailfish-on-merlinx/droid-config-merlinx"
		revision="main" />
	<project path="hybris/droid-hal-version-merlinx"
		name="sailfish-on-merlinx/droid-hal-version-merlinx"
		revision="main" />

	<!-- hybris-boot: merlinx fork carrying fixup-mountpoints entry -->
	<remove-project name="mer-hybris/hybris-boot" />
	<project path="hybris/hybris-boot"
		name="sailfish-on-merlinx/hybris-boot"
		revision="a16" />

	<!-- merlinx-patches: device-specific adaptation patches -->
	<project path="merlinx-patches"
		name="sailfish-on-merlinx/merlinx-patches"
		revision="main" />

	<!-- Drop Chromium WebView patches: not needed in SFOS and causes dangling symlinks -->
	<remove-project name="LineageOS/android_external_chromium-webview_patches" />
</manifest>
